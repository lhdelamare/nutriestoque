# ============================================================
# VARIÁVEIS DE AMBIENTE - NUTRIESTOQUE SERVER (COOLIFY / PRODUÇÃO)
# ============================================================

# Porta onde o servidor API vai escutar
PORT=3001

# Ambiente de execução
NODE_ENV=production

# ------------------------------------------------------------
# CONEXÃO BANCO DE DADOS MYSQL SEPARADA
# ------------------------------------------------------------
DB_HOST="mysql"            # Host / Nome do container no Coolify ou IP do servidor
DB_PORT="3306"             # Porta padrão do MySQL
DB_USER="root"             # Usuário do banco
DB_PASSWORD="sua_senha_aqui" # Senha do banco
DB_NAME="nutri_estoque"    # Nome do banco de dados

# Chave secreta de autenticação
JWT_SECRET="nutri_estoque_senai_secret_key_2026"
